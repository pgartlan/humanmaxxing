# ship.env — script-read configuration for the ship skill. Copy to ship.env next to SKILL.md; the getting-started
# onboarding fills it (or fill it by hand). KEY=value lines and # comments on their own lines only (a value may not begin with #, and a # after a value is part of the value). The scripts parse this file; they never
# source it. EXCEPTION: the *_CMD keys are commands the scripts RUN with bash -c; review changes to this file like code.
# Prerequisites: git ≥ 2.23, gh (authenticated), jq, sha256sum or shasum. Install the skill in-repo at .claude/skills/ship.

# The branch PRs merge into. Every merge-base, fetch and push lease is against origin/<this>. REQUIRED.
BASE_BRANCH=main

# The GitHub repository every `gh` call targets, as owner/repo. Set it when origin is not that repository (a mirror,
# or a checkout with several GitHub remotes): the scripts export it as GH_REPO, which gh honors, and prose `gh`
# commands in SKILL.md add `--repo <it>`. Empty = gh's default resolution (from the git remotes).
GH_REPO=

# offload: open a draft PR early and let CI run the heavy tier; local: run everything here and open a ready PR.
DEFAULT_MODE=offload

# queue: a label enqueues and a bot merges (set QUEUE_LABEL; optionally QUEUE_STATE_CMD). direct: `gh pr merge` with the
# MERGE_FLAGS prose slot from SKILL.md.
MERGE_METHOD=direct
QUEUE_LABEL=
# A command printing queued|dequeued|unknown for the PR in $PR (your provider's authoritative state, e.g. a status comment's
# payload). Optional; without it a dequeue surfaces as LABEL_MISSING or TIMEOUT.
QUEUE_STATE_CMD=

# sentinel: the review-code skill writes the review and E2E sentinels. This is the default whenever review-code is
# installed (onboarding installs it so). manual: ONLY the fallback when review-code is not installed (skipped, or the
# repository kept its own review skill): the gates then accept the USER's attestation (`ship-sentinel.sh attest … --user`),
# bound to the tree, and the PR body says "manual attestation" and quotes them.
REVIEW_GATE=sentinel

# required: the base branch runs CI on push and the ship waits for it after the merge. none: no post-merge CI exists.
POSTMERGE_CI=required

# The required status contexts. Preferred: REQUIRED_CHECKS_CMD, a command printing the LIVE required set one per line (from
# branch protection plus your queue's conditions; `$PR` is set); a failing command is a watch error, never "any green". A static
# REQUIRED_CHECKS csv drifts from branch protection. Both unset = every context in the rollup is required (fail closed).
REQUIRED_CHECKS_CMD=
REQUIRED_CHECKS=
# Contexts the CI watch ignores entirely (a queue provider's always-pending check).
IGNORED_CHECKS=

# One glob per line: paths whose change needs real E2E before merge. Shared with review-code's CRITICAL_GLOBS.
# Leave the value EMPTY to opt out (every diff E2E-exempt). A named file that is missing is an error, never "no globs".
CRITICAL_GLOBS_FILE=.claude/critical-paths.txt

# ERE over paths that cannot change runtime behavior. Both bindings exclude them (the review fingerprint and the check
# binding Phase 1 and the task results use), so docs written after the checks ran do not invalidate them. Worked default:
DOCS_ALLOWLIST=(\.md$|\.txt$|^docs/|(^|/)CHANGELOG)
# ERE re-including docs-allowlisted files that a check, lint or test READS (a baseline JSON, a registry, an invariants doc):
# they stay in the fingerprint. Empty when none.
DOCS_KEEP_BOUND=

# Optional: a file in the checkout listing the issue numbers this branch targets (numbers separated by whitespace,
# commas or dashes). Read by `ship-status.sh issues`, left out of the check binding, never an untracked-file finding.
# The worktree skill's own per-worktree issue list is read automatically. Empty = none.
ISSUE_MARKER_FILE=

# Sentinel age limits in seconds (worked default 12 h). Freshness is the content fingerprint; the TTL only forces a
# re-attestation on a very long ship. Hash and age are checked independently.
REVIEW_TTL_SECONDS=43200
E2E_TTL_SECONDS=43200

# OFFLOAD fix pushes before the skill stops and asks the user what to do next.
FIX_ROUND_CAP=10

# The age (minutes since it started) past which a still-running required CI run counts as stuck, so a fix push may cancel
# it after the 20-minute pre-push wait. Below it the wait is re-armed: pushing cancels a healthy run and costs a round.
PRE_PUSH_CEILING_MINUTES=60

# Where reviewed plans live (`<dir>/<issue>-*.md`): the close-out check reads a plan's `## PRs` table, whose Owns column
# (User-approved? yes) declares an additional PR that closes an issue instead of this one. Worked default:
PLANS_DIR=docs/plans

# Release actions. none: the PR body is documentation only. file-ledger: obligations go in ```release-action blocks in the
# PR body, linted and harvested into an in-repo ledger by `ship-release.sh`, with YOUR tooling: RELEASE_ACTION_LINT_CMD (exit
# 1 on action-shaped prose outside a block; BODY=<body file> is set), RELEASE_ACTION_HARVEST_CMD (appends the blocks under
# RELEASE_LEDGER_DIR; BODY is set), and RELEASE_LEDGER_DIR (staged and read back). file-ledger with any of them empty is exit 2.
RELEASE_ACTIONS=none
RELEASE_ACTION_LINT_CMD=
RELEASE_ACTION_HARVEST_CMD=
RELEASE_LEDGER_DIR=

# The Phase-1 checks, bound to their commands, so the required list is configuration and never "whatever was launched".
# CHECK_TASKS: comma-separated <name>:<local|offload|both> (both when the mode is left out). Every listed name needs a
# CHECK_CMD_<name>=<command> line; `ship-run.sh start <name>` runs it, and `write phase1` refuses until every name for the
# current mode is green on this tree (one never launched counts as pending). A listed name with an empty command is a
# configuration error (exit 2): an empty command exits 0 and would record a green that checked nothing. Worked example:
#   CHECK_TASKS=lint:both,typecheck:both,unit:local,secrets:both
#   CHECK_CMD_lint=npm run lint
# Unset: the required list is the tasks that were launched (the first install leaves its check slots empty), and the
# PR body says so.
CHECK_TASKS=
