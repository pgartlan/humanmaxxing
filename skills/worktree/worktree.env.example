# worktree.env — script-read configuration for the worktree skill. Copy to worktree.env next to SKILL.md; the
# getting-started onboarding fills it (or fill it by hand). KEY=value lines and # comments on their own lines only (a value may not begin with #, and a # after a value is part of the value). The scripts parse this
# file; they never source it. EXCEPTION: the *_CMD keys are commands the scripts RUN with bash -c; review changes to
# this file like code. Values a command needs arrive as environment variables (named at each key), never pasted in.
# Prerequisites: git 2.23 or later, bash 3.2 or later. The GitHub issue commands below (bin/worktree-issue.sh) also
# need `gh`, signed in; with a board (ISSUE_PROJECT set) its token needs the `project` scope (`gh auth refresh -s project`).

# The branch new work starts from and merges back into. REQUIRED. Use the same value as your ship and start skills.
BASE_BRANCH=main

# The remote that holds BASE_BRANCH. Leave the line out for `origin`. Set it EMPTY (BASE_REMOTE=) for a repository with
# no remote: branches start from the local base, nothing is fetched or pushed, and "merged" is judged locally.
BASE_REMOTE=origin

# Where worktree folders are created. Empty = one folder per repository: <repo>-worktrees beside the main checkout
# (e.g. ~/app-worktrees for ~/app; made by the first create), so different repositories' worktrees never mix. A
# bare-repository layout keeps them beside the bare repository. The WORKTREE_PARENT_DIR environment variable
# overrides this per machine; a folder named either way must already exist.
WORKTREE_PARENT_DIR=

# Space-separated paths, relative to the repository root, copied from the checkout you run the script in into the new
# worktree: files git does not carry (a local env file, an editor config). Names, not patterns, and no spaces in a
# name. Never overwrites; a missing file is a warning.
COPY_FILES=

# Run inside the new worktree after it is created: your dependency install. WORKTREE_PATH, BRANCH, ISSUES are set.
# Example: POST_CREATE_CMD=npm ci
POST_CREATE_CMD=
# wait: run it in the foreground; a failure is exit 6. background: detach it and print where its log and exit status
# land (the launcher always uses background, so the session starts while the install runs).
POST_CREATE_MODE=wait

# --- Issue flow: starting work on an issue always guards, claims and pushes, for a team of one or a thousand ---
# The defaults use GitHub through `gh` (bin/worktree-issue.sh; WT_BIN and WT_CONFIG are set for every command here).
# Another tracker: put its commands in the three slots. No tracker at all: leave the three slots empty.
# Prints the issue's title on one line. ISSUE is set. Empty = branches are named by number alone.
ISSUE_TITLE_CMD=bash "$WT_BIN/worktree-issue.sh" title
# Exit 0 when the issue may be started; any other exit refuses the create before anything exists (--force skips it).
# The default: open, on the board in a startable status (or, with no board, unassigned or assigned to you).
ISSUE_GUARD_CMD=bash "$WT_BIN/worktree-issue.sh" guard
# Runs once per issue after the worktree exists: assign it to you, move it to in-progress, comment the branch.
# ISSUE, ISSUES, BRANCH and WORKTREE_PATH are set. A failure is exit 6 (the worktree stays).
ISSUE_CLAIM_CMD=bash "$WT_BIN/worktree-issue.sh" claim
# The GitHub repository the issue commands use, as owner/repo. Set it when origin is not that repository (a mirror,
# or several GitHub remotes): the scripts export it as GH_REPO, which gh and your slot commands inherit. Empty = gh's
# default resolution (from the git remotes). The same value as your ship and retro skills.
GH_REPO=
# The board the default guard and claim read and move: <owner>/<number> of a GitHub project. Empty = no board.
ISSUE_PROJECT=
# The board's status field, the statuses an issue may be started from (comma-separated), and the in-progress status.
ISSUE_STATUS_FIELD=Status
ISSUE_STARTABLE=Backlog,Ready
ISSUE_IN_PROGRESS=In progress
# 1: push the new branch (with upstream) when it is created from an issue, so the claim comment names a real branch.
PUSH_ON_ISSUE=1
# Longest derived branch name, in characters (20-200). The issue-number prefix is never cut; the title part is.
BRANCH_MAX_LEN=50

# --- Launcher (worktree-start.sh; see references/launcher.md) ---
# The command that becomes the session, run inside the worktree. MODEL, ISSUES (space-separated), BRANCH and
# WORKTREE_PATH are set. Per-harness examples are in references/launcher.md.
START_CMD=claude --model "$MODEL" --effort high "/start $ISSUES"
# The model words the launcher accepts on its command line (lowercase, space-separated), and the one used when none is
# given (set it whenever START_CMD uses $MODEL).
START_MODELS=opus sonnet haiku fable
START_DEFAULT_MODEL=opus
# How long the launcher waits for a folder to become a valid checkout before giving up (seconds).
START_WAIT_SECONDS=120
