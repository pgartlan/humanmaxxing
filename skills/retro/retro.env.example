# retro.env — script-read configuration for the retro skill. Copy to retro.env next to SKILL.md; the getting-started
# onboarding fills it from answers it already has (or fill it by hand). KEY=value lines and # comments on their own
# lines only (a value may not begin with #, and a # after a value is part of the value). bin/retro-data.sh parses this
# file; it never sources it, and nothing in it is run as a command.
# Prerequisites: git, bash 3.2 or later. With TRACKER=github: `gh`, signed in, with read access to the repository.

# The branch shipped work lands on. REQUIRED. The same value as your ship and worktree skills. The window's history is
# read from <BASE_REMOTE>/<BASE_BRANCH> when that remote-tracking branch exists, else from the local branch. The script
# never fetches; the report shows the tip's date, so stale history is visible.
BASE_BRANCH=main
# Leave the line out for `origin`; set it EMPTY (BASE_REMOTE=) for a repository with no remote.
BASE_REMOTE=origin

# How commit messages say what kind of change they are. REQUIRED.
#   conventional — `feat:`, `fix:`, `docs:`, `chore:` (refactor, test, ci, build, perf and style count as chore;
#                  a scope and a ! are allowed: `fix(api)!: ...`). A message without a prefix counts as other.
#   keywords     — plain messages, sorted by whole words in them, first list that matches wins: fix, then feat, then
#                  docs, then chore ("Fix crash in login" is a fix; "prefix" is not). The lists below override the
#                  defaults shown; comma-separated, case does not matter.
COMMIT_STYLE=conventional
# FIX_WORDS=fix,fixes,fixed,bug,bugfix,hotfix,regression,broken,crash
# FEAT_WORDS=feat,feature,add,adds,added,implement,implements,introduce,introduces,new,support
# DOCS_WORDS=docs,doc,documentation,readme,changelog
# CHORE_WORDS=chore,refactor,cleanup,bump,deps,dependencies,rename,ci,build,test,tests,lint,format

# A fix chain is one file, or one folder, touched by this many fix commits in the window (each commit counted once
# per file or folder). 3 is a worked default: calibrate it for your repository's pace.
FIX_CHAIN_MIN=3

# Where issues and pull requests live. REQUIRED.
#   github — read-only `gh` queries: issues opened and closed in the window, pull requests merged in it.
#   none   — git history only; the report says which sections could not be filled.
TRACKER=github
# With TRACKER=github: the repository the queries read, as owner/repo. Set it when origin is not that repository (a
# mirror, or several GitHub remotes); the script exports it as GH_REPO, which gh honors. Empty = gh's default
# resolution (from the git remotes). The same value as your ship and worktree skills.
GH_REPO=

# Where the report is written: <REPORT_DIR>/retro-<YYYY-MM-DD>.md. REQUIRED. Relative to the repository root, under
# your docs root (for example docs/retros).
REPORT_DIR=docs/retros

# Where your code-review skill writes its findings, one file per branch (review-code's FINDINGS_LOG_DIR). Empty = the
# recurring-findings section says it is not configured.
FINDINGS_DIR=

# OPTIONAL: where session or chat summaries are committed (your ship skill's CHAT_SUMMARY_DIR). The retro reads the
# ones written in the window as evidence for what broke and what to change. Empty = not read, and the report says so.
SESSION_NOTES_DIR=

# Your rules file. The repeat-bug threshold is read from its "Fix the Class, Not the Instance" rule, never set here,
# so the two cannot disagree. Default CLAUDE.md at the repository root.
CLAUDE_MD=CLAUDE.md

# OPTIONAL guard-growth count: files added in the window that match these patterns (space-separated, `**` allowed),
# for example: GUARD_GLOBS=lint/rules/** scripts/check-*
# Empty = the count is off. GUARD_BUDGET_PER_MONTH: new guards a month the report compares against. It is a tripwire,
# not a cap and never a target: every guard costs every later change (run time, false positives, upkeep), so guards
# are earned by repeats, and steady growth past the budget is worth a look. Worked value 10; empty = no budget (the
# count is still reported, against nothing).
GUARD_GLOBS=
GUARD_BUDGET_PER_MONTH=10

# Where new HumanMaxxing releases are published: the git URL of the repository you downloaded the skills from (the
# onboarding fills it from the download's own `git remote get-url origin` when the download is a clone). Read with
# `git ls-remote --tags` only. Empty = the framework-currency section says "release source not configured". A local
# download passed as `--download <dir>` is used instead when given.
RELEASE_REPO_URL=
