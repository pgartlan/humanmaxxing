# hooks.env — this repository's values for the hooks pack. Copied to .claude/hooks/hooks.env and filled in at
# install. KEY=value lines and # comments on their own lines only; the hooks parse this file, they never source it,
# and a malformed file makes them refuse rather than guess. Every hook reads the hooks.env of the repository a call
# targets, so a session working in a sibling worktree is governed by that worktree's file.

# warn | enforce. Written by the installer's --mode (the onboarding installs with --mode warn, so the first install
# never blocks itself). Absent or any other value = enforce. warn: the protected-file guard and the commit check never
# ask or refuse; they allow the call and print what they would have done, prefixed "warn-only:" (on stderr and as a
# message to the session; the commit check still runs its check). Exception, by design: .claude/settings.json and
# .claude/settings.local.json are still asked about in warn mode: they hold the permission settings and can switch the
# hooks off, so a write there is silent self-escalation, not a gate on merging the install. Configuration errors are
# still asked about too. To switch on: run the same install with --mode enforce (plan, then apply).
# review-nudge (the once-per-session reminder to run the review-code skill before stopping) reads it too: warn = it
# prints the reminder only; enforce = it holds the stop once. pending-question-reprint does not read this key.
HOOKS_MODE=enforce

# The protected list: one glob per line (`*`, `?`, `**`), # comments on their own lines carry each file's reason.
# Always protected, whatever the list says: the hooks folder, the list itself, .claude/settings.json and
# .claude/settings.local.json; and, while this repository is governed, any .claude/settings.json or
# .claude/settings.local.json a file tool targets, wherever it is (another worktree, a subfolder, ~/.claude).
PROTECTED_FILES_FILE=.claude/protected-files.txt

# The command that must pass before any commit the agent makes, run with `bash -c` from the repository's top level
# (for example your invariant check, a secret scan, or both joined with &&). Empty = no commit check.
COMMIT_CHECK_CMD=

# How long the commit check may run, in whole seconds, 1 or more. A check that has not finished by then has not passed.
COMMIT_CHECK_TIMEOUT_SECS=60
